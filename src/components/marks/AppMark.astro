---
// The logo of each uni rakun app, drawn in its round badge.
import { Image } from "astro:assets"
import kojimo from "../../images/kojimo.png"
import qrakun from "../../images/qrakun.png"
import type { Product } from "../../data/products"

interface Props {
  id: Product["id"]
  size?: number
}
const { id, size = 44 } = Astro.props
---

{id === "kojimo" && (
  <Image
    src={kojimo}
    alt=""
    width={128}
    height={128}
    style="width: 100%; height: 100%; object-fit: cover"
  />
)}
{id === "qrakun" && (
  <Image
    src={qrakun}
    alt=""
    width={size + 4}
    style={`width: ${size + 4}px; height: auto`}
  />
)}
{id === "wagle" && (
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <path
      fill="#f2a93b"
      d="M24.5 27.6 C 30.5 26.2 37.6 28.8 41.9 33.6 C 45.9 38.2 47.2 44.6 45.3 49.8 C 43.9 53.8 39.9 56.4 34.9 56.5 L 24.4 56.5 C 19.2 56.4 15.7 53.2 15.1 48.6 C 14.6 44.8 14.9 40.9 15.8 37.6 C 13.6 36.4 11.6 35.2 10.2 33.4 C 8.9 31.6 9.0 29.2 10.2 27.8 C 11.4 26.2 13.0 23.9 14.2 21.6 C 15.3 19.4 17.3 18.2 19.6 18.2 C 22.8 18.3 25.4 20.3 26.4 23.3 C 27.1 25.2 26.4 26.9 24.5 27.6 Z"
    />
    <path
      fill="#cd850d"
      d="M20.6 18.5 C 24 17.9 26.9 19.8 27.7 22.9 C 28.3 25.3 27.4 27.6 25.4 28.7 C 23.3 27.5 21.6 25.4 20.7 22.9 C 20.3 21.5 20.4 19.9 20.6 18.5 Z"
    />
    <circle cx="9.3" cy="30" r="2" fill="#cd850d" />
    <g fill="none" stroke="#cd850d" stroke-linecap="round" stroke-width="5.2">
      <path d="M40.5 42.95 L 42.6 39.6" />
      <path d="M41.5 41.4 C 42.7 39.0 43.8 37.1 44.6 35.4" />
      <path d="M43.2 38.1 C 44.2 36.1 45.1 34.2 45.6 32.5" />
      <path d="M44.5 35.0 C 45.3 33.0 46.0 30.6 46.1 28.5" />
    </g>
  </svg>
)}
{id === "brikia" && (
  <svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
    <g
      fill="rgb(255,247,242)"
      fill-opacity="0.35"
      stroke="rgb(255,247,242)"
      stroke-width="5"
      stroke-linejoin="round"
    >
      <polygon points="95,31.76 67.57,19.05 67.15,36.63 93.79,50.14" />
      <polygon points="67.57,19.05 5,44.39 6.36,63.52 67.15,36.63" />
      <polygon points="32.19,80.95 93.79,50.14 67.15,36.63 6.36,63.52" />
      <polygon points="5,44.39 67.57,19.05 95,31.76 31.56,60.9" />
      <polygon points="31.56,60.9 95,31.76 93.79,50.14 32.19,80.95" />
      <polygon points="5,44.39 31.56,60.9 32.19,80.95 6.36,63.52" />
    </g>
  </svg>
)}
{id === "moovi" && (
  <svg width={size} height={size} viewBox="96 96 320 320" aria-hidden="true">
    <g fill="none" stroke="#fafafa" stroke-width="40">
      <circle cx="196" cy="256" r="82" />
      <circle cx="316" cy="256" r="82" />
    </g>
  </svg>
)}
{id === "woof" && (
  // Woof's real logo is the outlined paw print of lucide (its site uses it
  // next to the wordmark); the favicon's filled paw is not the brand mark.
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="#f2f4f1"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="4" r="2" />
    <circle cx="18" cy="8" r="2" />
    <circle cx="20" cy="16" r="2" />
    <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
  </svg>
)}
