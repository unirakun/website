---
// A headline whose *starred* words get the blue pen underline, the site's
// signature, and whose ~tilded~ words get struck through in red pen. The
// marks draw themselves as they scroll into view; `delay` (ms) holds them
// back, for the hero, which first rises into place.
interface Props {
  text: string
  as?: "h1" | "h2" | "h3" | "p" | "span"
  class?: string
  delay?: number
}
const { text, as: Tag = "h2", class: className, delay } = Astro.props
const style = delay === undefined ? undefined : `--mark-delay: ${delay}ms`
const parts = text
  .split(/(\*[^*]+\*|~[^~]+~)/)
  .filter(Boolean)
  .map((part) =>
    part.startsWith("*")
      ? { text: part.slice(1, -1), mark: "key" }
      : part.startsWith("~")
        ? { text: part.slice(1, -1), mark: "key strike" }
        : { text: part, mark: "" }
  )
---

<Tag class={className}>
  {parts.map((part) =>
    part.mark ? (
      <span class={part.mark} style={style}>
        {part.text}
      </span>
    ) : (
      part.text
    )
  )}
</Tag>
