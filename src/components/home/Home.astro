---
import Layout from "../../layouts/Layout.astro"
import Header from "./Header.astro"
import Hero from "./Hero.astro"
import Services from "./Services.astro"
import Steps from "./Steps.astro"
import Apps from "./Apps.astro"
import Team from "./Team.astro"
import Faq from "./Faq.astro"
import Contact from "./Contact.astro"
import { COPY, WHATSAPP_NUMBER, plain, type Lang } from "../../i18n/copy"
import { PRODUCTS } from "../../data/products"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = COPY[lang]
const site = "https://unirakun.fr"
const path = lang === "fr" ? "/" : "/en/"
const url = `${site}${path}`

// Structured data: the studio, its two founders, its apps and the FAQ, so
// search engines and AI assistants can answer "who builds what" directly.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: "uni rakun",
      inLanguage: ["fr-FR", "en-US"],
      publisher: { "@id": `${site}/#org` },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${site}/#org`,
      name: "uni rakun",
      url: `${site}/`,
      logo: `${site}/logo.png`,
      image: `${site}/og.png`,
      description: t.meta.description,
      slogan: plain(`${t.title1} ${t.title2}`),
      telephone: `+${WHATSAPP_NUMBER}`,
      areaServed: { "@type": "Country", name: "France" },
      location: [
        {
          "@type": "Place",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Nantes",
            addressCountry: "FR",
          },
        },
        {
          "@type": "Place",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Saumur",
            addressCountry: "FR",
          },
        },
      ],
      founder: [{ "@id": `${site}/#guillaume` }, { "@id": `${site}/#fabien` }],
      knowsAbout: [
        "Custom software development",
        "AI-powered applications",
        "AI agents",
        "Model Context Protocol (MCP)",
        "SaaS",
        "TypeScript",
        "React",
        "Go",
        "Kubernetes",
        "Google Cloud",
      ],
      sameAs: [
        "https://github.com/unirakun",
        "https://www.linkedin.com/company/unirakun",
      ],
    },
    {
      "@type": "Person",
      "@id": `${site}/#guillaume`,
      name: "Guillaume CRESPEL",
      givenName: "Guillaume",
      familyName: "Crespel",
      jobTitle:
        lang === "fr"
          ? "C(P)TO et développeur freelance"
          : "C(P)TO and freelance developer",
      description: t.gLine,
      url: "https://guillaumecrespel.fr",
      image: `${site}/guillaume-crespel.png`,
      homeLocation: { "@type": "Place", name: "Nantes, France" },
      worksFor: { "@id": `${site}/#org` },
      sameAs: [
        "https://guillaumecrespel.fr",
        "https://www.linkedin.com/in/guillaume-crespel",
        "https://github.com/guillaumecrespel",
        "https://www.malt.fr/profile/guillaumecrespel",
      ],
    },
    {
      "@type": "Person",
      "@id": `${site}/#fabien`,
      name: "Fabien JUIF",
      givenName: "Fabien",
      familyName: "Juif",
      jobTitle: lang === "fr" ? "Ingénieur logiciel" : "Software engineer",
      description: t.fLine,
      homeLocation: { "@type": "Place", name: "Saumur, France" },
      worksFor: { "@id": `${site}/#org` },
      sameAs: [
        "https://www.linkedin.com/in/fabienjuif",
        "https://github.com/fabienjuif",
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${url}#apps`,
      name: plain(t.appsTitle),
      itemListElement: PRODUCTS.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "SoftwareApplication",
          name: p.name,
          url: p.url,
          applicationCategory: p.category,
          operatingSystem: "Web",
          description: `${p.pitch[lang]}. ${p.body[lang]}`,
          creator: { "@id": `${site}/#org` },
        },
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${url}#faq`,
      inLanguage: t.htmlLang,
      mainEntity: t.faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
  ],
}
---

<Layout
  lang={t.htmlLang}
  locale={t.locale}
  title={t.meta.title}
  description={t.meta.description}
  path={path}
  alternates={[
    { hreflang: "fr", href: "/" },
    { hreflang: "en", href: "/en/" },
    { hreflang: "x-default", href: "/" },
  ]}
  jsonLd={jsonLd}
>
  <a class="skip-link" href="#main">
    {t.skip}
  </a>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Services lang={lang} />
    <Steps lang={lang} />
    <Apps lang={lang} />
    <Team lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>
