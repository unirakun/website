---
import Raccoon from "../Raccoon.astro"
import KeyText from "../KeyText.astro"
import Icon from "../icons/Icon.astro"
import Doodle from "../Doodle.astro"
import { COPY, whatsappUrl, type Lang } from "../../i18n/copy"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = COPY[lang]
---

<section class="wrap hero" id="top">
  <div class="text">
    <p class="kicker">{t.kicker}</p>
    <h1>
      {t.title1}
      <br />
      <KeyText as="span" class="marker hand" text={t.title2} draw />
    </h1>
    <p class="lead">{t.lead}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={whatsappUrl(lang)}>
        <Icon name="whatsapp" size={16} />
        {t.cta1}
      </a>
      <a class="btn" href="#methode">
        {t.cta2}
      </a>
    </div>
  </div>

  <div class="drawing">
    <Raccoon class="hero-raccoon" />
  </div>

  <ul class="proof">
    {t.promises.map((line, i) => (
      <li>
        <span class="tick">
          <Doodle name="check" seed={i + 3} size={28} />
        </span>
        <span>{line}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px 48px;
    padding-block: 64px 96px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .text > * {
    animation: rise var(--enter) var(--ease) both;
  }
  .text > :nth-child(2) {
    animation-delay: 50ms;
  }
  .text > :nth-child(3) {
    animation-delay: 100ms;
  }
  .text > :nth-child(4) {
    animation-delay: 150ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .kicker {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  h1 :global(.hand) {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.92em;
    letter-spacing: 0;
  }
  .lead {
    margin: 0;
    max-width: 36rem;
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .drawing {
    display: flex;
    justify-content: center;
    color: var(--fg);
  }
  .drawing :global(.hero-raccoon) {
    width: 100%;
    max-width: 480px;
    height: auto;
  }
  .proof {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .proof li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .tick {
    display: flex;
    flex: none;
    margin-top: -2px;
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 32px 64px;
    }
    .drawing {
      order: -1;
      justify-content: flex-start;
    }
    .drawing :global(.hero-raccoon) {
      max-width: 200px;
    }
  }
  @media (max-width: 720px) {
    /* The header already carries the raccoon on phones. */
    .drawing {
      display: none;
    }
    .lead {
      font-size: 16px;
    }
    .ctas .btn {
      flex: 1 1 100%;
    }
    .proof {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
