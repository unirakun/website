---
import Doodle from "../Doodle.astro"
import KeyText from "../KeyText.astro"
import { COPY, type Lang } from "../../i18n/copy"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = COPY[lang]
---

<section class="wrap section services" id="services">
  <div class="intro">
    <KeyText class="section-title" text={t.servicesTitle} />
    <p class="section-lead">{t.servicesLead}</p>
    <div class="vibe">
      <KeyText as="p" class="vibe-title marker" text={t.stamp} />
      <p class="vibe-line">{t.stampLine}</p>
    </div>
  </div>

  <ul class="list">
    {t.services.map((s) => (
      <li>
        <span class="icon">
          <Doodle
            name={s.icon as "layout" | "ai" | "shield"}
            seed={s.icon.length * 7}
            size={44}
          />
        </span>
        <div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    align-items: start;
    gap: 48px 64px;
  }
  .intro .section-lead {
    margin-bottom: 40px;
  }
  .vibe {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .vibe :global(.vibe-title) {
    margin: 0;
    font-size: 28px;
    line-height: 1.2;
  }
  .vibe-line {
    margin: 0;
    max-width: 32rem;
    color: var(--text-2);
  }
  .list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    list-style: none;
  }
  .list li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 24px;
  }
  .list li + li {
    border-top: 1px solid var(--line);
  }
  .icon {
    display: flex;
    width: 44px;
    height: 44px;
    color: var(--fg);
  }
  h3 {
    margin: 0 0 4px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }
  .list p {
    margin: 0;
    color: var(--text-2);
  }

  @media (max-width: 860px) {
    .services {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .intro {
      display: contents;
    }
    .intro :global(.section-title),
    .intro .section-lead {
      order: 0;
    }
    .intro .section-lead {
      margin-bottom: 0;
    }
    .list {
      order: 1;
    }
    .vibe {
      order: 2;
    }
  }
  @media (max-width: 720px) {
    .list li {
      padding: 16px;
    }
    .vibe :global(.vibe-title) {
      font-size: 24px;
    }
  }
</style>
