---
// The six apps, all with the same weight: one card shape for everyone, on the
// page's paper, with an ink outline and a slight tilt like stickers in a
// sketchbook. Each app's own colour lives in its logo tile, its hard shadow
// and its link, so the grid stays coherent whatever the brand.
import AppMark from "../marks/AppMark.astro"
import Icon from "../icons/Icon.astro"
import KeyText from "../KeyText.astro"
import { PRODUCTS } from "../../data/products"
import { COPY, type Lang } from "../../i18n/copy"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = COPY[lang]
const tilts = ["-1deg", "0.8deg", "-0.6deg", "1deg", "-0.8deg", "0.6deg"]
---

<section class="wrap section" id="apps">
  <KeyText class="section-title" text={t.appsTitle} />
  <p class="section-lead">{t.appsLead}</p>
  <div class="grid rail">
    {PRODUCTS.map((p, i) => (
      <a
        class="app"
        href={p.url}
        style={`--tilt: ${tilts[i]}; --icon-bg: ${p.iconBg}; --c-light: ${p.color}; --c-dark: ${p.colorDark}; --i-light: ${p.ink}; --i-dark: ${p.inkDark}`}
      >
        <span class="top">
          <span
            class:list={[
              "mark",
              { light: p.iconBg.toLowerCase() === "#ffffff" },
            ]}
          >
            <AppMark id={p.id} size={30} />
          </span>
          <span class="name">{p.name}</span>
        </span>
        <strong class="pitch">{p.pitch[lang]}</strong>
        <span class="body">{p.body[lang]}</span>
        <span class="domain">
          {p.domain}
          <Icon name="arrow" size={16} />
        </span>
      </a>
    ))}
  </div>
  <p class="rail-hint">{t.swipe}</p>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .app {
    --app-color: var(--c-light);
    --app-ink: var(--i-light);
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 2px solid var(--fg);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--fg);
    box-shadow: 6px 6px 0 var(--app-color);
    transform: rotate(var(--tilt));
    transition:
      transform var(--fast) var(--ease),
      box-shadow var(--fast) var(--ease);
  }
  :global([data-theme="dark"]) .app {
    --app-color: var(--c-dark);
    --app-ink: var(--i-dark);
  }
  .app:hover,
  .app:focus-visible {
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--app-color);
  }
  .top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mark {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--icon-bg);
  }
  .mark.light {
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .name {
    font-size: 16px;
    font-weight: 600;
  }
  .pitch {
    margin-top: 16px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .domain {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding-top: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--app-ink);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }
  @media (max-width: 720px) {
    .app {
      padding: 20px;
      box-shadow: 4px 4px 0 var(--app-color);
    }
    .app:hover {
      transform: rotate(var(--tilt));
      box-shadow: 4px 4px 0 var(--app-color);
    }
    .pitch {
      font-size: 20px;
    }
  }
</style>
